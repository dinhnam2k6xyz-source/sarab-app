# ==============================================================================
# NOVEL TRANSLATOR AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL or SQLite)
# For Local without Docker: sqlite+aiosqlite:///./novel_translator.db
# For Docker: postgresql+asyncpg://postgres:postgrespassword@postgres:5432/novel_translator
DATABASE_URL=sqlite+aiosqlite:///./novel_translator.db

# Redis Connection (Queue & Realtime)
REDIS_URL=redis://localhost:6379/0

# Translation Provider Options: gemini | openai | deepl | offline
TRANSLATION_PROVIDER=gemini
FALLBACK_PROVIDER=offline

# AI API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPL_API_KEY=

# Security
SECRET_KEY=novel-translator-super-secret-key-change-in-production-2026

# Scraping & Anti-abuse Settings
SCRAPER_TIMEOUT_SECONDS=25
RATE_LIMIT_ANALYZE_PER_MINUTE=20
RATE_LIMIT_TRANSLATE_PER_MINUTE=60

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
